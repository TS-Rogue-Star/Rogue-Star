#undef CUSTOM_MARKING_ATLAS_MANIFEST_REVISION
#undef CUSTOM_MARKING_ATLAS_MAX_DIMENSION
#undef CUSTOM_MARKING_ATLAS_PERSISTENT_CACHE_REVISION

