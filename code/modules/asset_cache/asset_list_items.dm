#define CUSTOM_MARKING_ATLAS_SPRITE_SIZE 1
#define CUSTOM_MARKING_ATLAS_SPRITE_INDEX 2
#define CUSTOM_MARKING_ATLAS_SIZE_COUNT 1
#define CUSTOM_MARKING_ATLAS_SIZE_ICON 2
#define CUSTOM_MARKING_ATLAS_SIZE_STRIPPED 3
#define CUSTOM_MARKING_ATLAS_MANIFEST_REVISION 4
#define CUSTOM_MARKING_ATLAS_MAX_DIMENSION 2048
#define CUSTOM_MARKING_ATLAS_PERSISTENT_CACHE_REVISION 1

/datum/asset/spritesheet/custom_marking_designer
	name = "custom_marking_designer"
	var/accepting_assets = TRUE
	var/finalized = FALSE
	var/assets_registered = FALSE
	var/construction_state_released = FALSE
	var/finalized_frame_count = 0
	var/finalized_sheet_count = 0
	var/list/finalized_asset_names = null
	var/list/finalized_sheet_diagnostics = null
	var/list/finalized_manifest = null
	var/finalized_manifest_asset_name = null
	var/next_sprite_id = 0
	var/requested_frame_count = 0
	var/reused_frame_count = 0
	var/list/payloads_by_sprite = list()
	var/list/payloads_by_canonical_key = list()
	var/list/payloads_by_asset_id = list()
	var/list/canonical_keys_by_asset_id = list()
	var/list/family_statistics = list()
	var/list/family_by_size_id = list()
	var/list/shard_index_by_bucket = list()
	var/list/prosthetic_catalog = list()
	var/persistent_cache_enabled = TRUE
	var/persistent_cache_path_override = null
	var/persistent_cache_validation_pending = FALSE
	var/persistent_cache_validation_failed = FALSE
	var/persistent_cache_loaded = FALSE
	var/persistent_cache_write_succeeded = FALSE
	var/persistent_cache_failure_reason = null
	var/list/persistent_cache_file_records = null
	var/list/persistent_cache_used_keys = null

/datum/asset/spritesheet/custom_marking_designer/register()
	if(!finalized || assets_registered)
		return
	..()
	assets_registered = TRUE
	return TRUE

/datum/asset/spritesheet/custom_marking_designer/send(client/C)
	if(!is_ready())
		return FALSE
	return send_asset_list(C, finalized_asset_names)

/datum/asset/spritesheet/custom_marking_designer/get_url_mappings()
	. = list()
	if(!is_ready())
		return
	for(var/asset_name in finalized_asset_names)
		.[asset_name] = get_asset_url(asset_name)

/datum/asset/spritesheet/custom_marking_designer/generate_css()
	return "/* Custom Marking Designer atlas; frames are addressed by payload coordinates. */"

/datum/asset/spritesheet/custom_marking_designer/proc/has_assets()
	if(finalized)
		return finalized_frame_count > 0 && finalized_sheet_count > 0
	return islist(sprites) && sprites.len

/datum/asset/spritesheet/custom_marking_designer/proc/is_ready()
	return finalized && assets_registered && construction_state_released && !persistent_cache_validation_pending && finalized_frame_count > 0 && finalized_sheet_count > 0

/datum/asset/spritesheet/custom_marking_designer/proc/can_accept_assets()
	return accepting_assets && !finalized

/datum/asset/spritesheet/custom_marking_designer/proc/get_frame_count()
	return finalized ? finalized_frame_count : (islist(sprites) ? sprites.len : 0)

/datum/asset/spritesheet/custom_marking_designer/proc/get_sheet_count()
	return finalized ? finalized_sheet_count : (islist(sizes) ? sizes.len : 0)

/datum/asset/spritesheet/custom_marking_designer/proc/get_requested_frame_count()
	return requested_frame_count

/datum/asset/spritesheet/custom_marking_designer/proc/get_reused_frame_count()
	return reused_frame_count

/datum/asset/spritesheet/custom_marking_designer/proc/has_released_construction_state()
	return construction_state_released

/datum/asset/spritesheet/custom_marking_designer/proc/get_manifest()
	return is_ready() && islist(finalized_manifest) ? finalized_manifest : null

/datum/asset/spritesheet/custom_marking_designer/proc/get_manifest_asset_name()
	return is_ready() && istext(finalized_manifest_asset_name) ? finalized_manifest_asset_name : null

/datum/asset/spritesheet/custom_marking_designer/proc/get_manifest_revision()
	return is_ready() ? CUSTOM_MARKING_ATLAS_MANIFEST_REVISION : null

/datum/asset/spritesheet/custom_marking_designer/proc/set_prosthetic_catalog(list/catalog)
	if(!islist(catalog))
		return FALSE
	if(persistent_cache_validation_pending)
		var/list/cached_catalog = finalized_manifest?["prosthetics"]
		if(!islist(cached_catalog) || json_encode(cached_catalog) != json_encode(catalog))
			return set_persistent_cache_failure("the live prosthetic catalog changed", TRUE)
		return TRUE
	if(!can_accept_assets())
		return FALSE
	prosthetic_catalog = catalog
	return TRUE

/datum/asset/spritesheet/custom_marking_designer/proc/get_prosthetic_catalog()
	if(finalized)
		return finalized_manifest?["prosthetics"]
	return prosthetic_catalog

/datum/asset/spritesheet/custom_marking_designer/proc/get_icon_asset(canonical_key)
	if(!istext(canonical_key) || !length(canonical_key))
		return null
	var/list/payload = payloads_by_canonical_key?[canonical_key]
	if(persistent_cache_validation_pending && islist(payload))
		if(!islist(persistent_cache_used_keys))
			persistent_cache_used_keys = list()
		persistent_cache_used_keys[canonical_key] = TRUE
	return payload

/datum/asset/spritesheet/custom_marking_designer/proc/is_valid_family(family)
	var/static/list/allowed_families = list("anatomy", "markings", "hair", "accessories", "species-gallery", "gear")
	return istext(family) && (family in allowed_families)

/datum/asset/spritesheet/custom_marking_designer/proc/get_or_create_family_statistics(family)
	if(!is_valid_family(family))
		return null
	var/list/statistics = family_statistics[family]
	if(!islist(statistics))
		statistics = list(
			"requested" = 0,
			"reused" = 0,
			"frames" = 0,
			"sheets" = list()
		)
		family_statistics[family] = statistics
	return statistics

/datum/asset/spritesheet/custom_marking_designer/proc/note_icon_asset_request(canonical_key, family = null)
	if(!is_valid_family(family))
		stack_trace("Custom Marking Designer canonical asset request rejected invalid family '[family]'.")
		return null
	var/list/payload = get_icon_asset(canonical_key)
	if(!islist(payload))
		return null
	if(persistent_cache_validation_pending)
		return payload
	requested_frame_count++
	reused_frame_count++
	var/list/statistics = get_or_create_family_statistics(family)
	if(!islist(statistics))
		return null
	statistics["requested"] = (statistics["requested"] || 0) + 1
	statistics["reused"] = (statistics["reused"] || 0) + 1
	return payload

/datum/asset/spritesheet/custom_marking_designer/proc/insert_family_frame(sprite_name, icon/source, family)
	if(!istext(sprite_name) || !length(sprite_name) || !isicon(source))
		return FALSE
	if(!is_valid_family(family))
		stack_trace("Custom Marking Designer canonical frame insertion rejected invalid family '[family]'.")
		return FALSE
	var/icon/frame_icon = icon(source)
	if(!isicon(frame_icon) || !length(icon_states(frame_icon)))
		return FALSE
	var/frame_width = max(1, frame_icon.Width())
	var/frame_height = max(1, frame_icon.Height())
	if(frame_width > CUSTOM_MARKING_ATLAS_MAX_DIMENSION || frame_height > CUSTOM_MARKING_ATLAS_MAX_DIMENSION)
		return FALSE
	var/max_columns = max(1, round(CUSTOM_MARKING_ATLAS_MAX_DIMENSION / frame_width))
	var/max_rows = max(1, round(CUSTOM_MARKING_ATLAS_MAX_DIMENSION / frame_height))
	var/shard_capacity = max(1, max_columns * max_rows)
	var/bucket_id = "[family]|[frame_width]x[frame_height]"
	var/shard_index = shard_index_by_bucket[bucket_id] || 1
	var/size_id = "[family]_[shard_index]_[frame_width]x[frame_height]"
	var/list/size = sizes[size_id]
	if(islist(size) && (size[CUSTOM_MARKING_ATLAS_SIZE_COUNT] || 0) >= shard_capacity)
		shard_index++
		shard_index_by_bucket[bucket_id] = shard_index
		size_id = "[family]_[shard_index]_[frame_width]x[frame_height]"
		size = sizes[size_id]
	if(islist(size))
		var/position = size[CUSTOM_MARKING_ATLAS_SIZE_COUNT]++
		var/icon/sheet = size[CUSTOM_MARKING_ATLAS_SIZE_ICON]
		size[CUSTOM_MARKING_ATLAS_SIZE_STRIPPED] = null
		sheet.Insert(frame_icon, icon_state = sprite_name)
		sprites[sprite_name] = list(size_id, position)
	else
		shard_index_by_bucket[bucket_id] = shard_index
		sizes[size_id] = list(1, frame_icon, null)
		sprites[sprite_name] = list(size_id, 0)
		family_by_size_id[size_id] = family
	return islist(sprites[sprite_name])

/datum/asset/spritesheet/custom_marking_designer/proc/get_sheet_diagnostic_summary()
	if(!islist(finalized_sheet_diagnostics) || !finalized_sheet_diagnostics.len)
		return "none"
	var/list/summary = list()
	for(var/asset_name in finalized_sheet_diagnostics)
		var/list/diagnostic = finalized_sheet_diagnostics[asset_name]
		if(!islist(diagnostic))
			continue
		var/frame_count = diagnostic["frames"] || 0
		var/width = diagnostic["width"] || 0
		var/height = diagnostic["height"] || 0
		var/family = diagnostic["family"]
		summary += "[asset_name] ([family]): [frame_count] frames, [width]x[height]"
	return summary.len ? summary.Join("; ") : "none"

/datum/asset/spritesheet/custom_marking_designer/proc/registered_assets_available()
	if(!SSassets || !islist(SSassets.cache))
		return FALSE
	if(!islist(finalized_asset_names) || finalized_asset_names.len != finalized_sheet_count + 2)
		return FALSE
	for(var/asset_name in finalized_asset_names)
		var/datum/asset_cache_item/cached_asset = SSassets.cache[asset_name]
		if(!istype(cached_asset) || !cached_asset.resource)
			return FALSE
	return TRUE

/datum/asset/spritesheet/custom_marking_designer/proc/set_persistent_cache_failure(reason, validation_failure = FALSE)
	persistent_cache_failure_reason = istext(reason) && length(reason) ? reason : "unspecified persistent cache failure"
	if(validation_failure || persistent_cache_validation_pending)
		persistent_cache_validation_failed = TRUE
	return FALSE

/datum/asset/spritesheet/custom_marking_designer/proc/get_persistent_cache_path()
	if(istext(persistent_cache_path_override) && length(persistent_cache_path_override))
		return persistent_cache_path_override
	return "data/spritesheets/[name]_persistent_cache_v[CUSTOM_MARKING_ATLAS_PERSISTENT_CACHE_REVISION].json"

/datum/asset/spritesheet/custom_marking_designer/proc/get_persistent_cache_failure_reason()
	return persistent_cache_failure_reason

/datum/asset/spritesheet/custom_marking_designer/proc/is_persistent_cache_validation_pending()
	return persistent_cache_validation_pending

/datum/asset/spritesheet/custom_marking_designer/proc/was_loaded_from_persistent_cache()
	return persistent_cache_loaded

/datum/asset/spritesheet/custom_marking_designer/proc/was_persistent_cache_written()
	return persistent_cache_write_succeeded

/datum/asset/spritesheet/custom_marking_designer/proc/get_persistent_cache_artifact_paths()
	var/list/paths = list(get_persistent_cache_path())
	if(islist(persistent_cache_file_records))
		for(var/asset_name in persistent_cache_file_records)
			var/list/file_record = persistent_cache_file_records[asset_name]
			var/cache_path = file_record?["path"]
			if(istext(cache_path) && length(cache_path) && !(cache_path in paths))
				paths += cache_path
	return paths

/datum/asset/spritesheet/custom_marking_designer/proc/load_persistent_cache_for_validation()
	persistent_cache_failure_reason = null
	persistent_cache_validation_failed = FALSE
	persistent_cache_loaded = FALSE
	if(!persistent_cache_enabled)
		return set_persistent_cache_failure("persistent caching is disabled")
	if(finalized || has_assets())
		return set_persistent_cache_failure("the atlas already contains construction state")
	var/cache_metadata_path = get_persistent_cache_path()
	if(!fexists(cache_metadata_path))
		return set_persistent_cache_failure("no persisted cache exists")
	var/cache_text
	var/list/cache_data
	try
		cache_text = file2text(cache_metadata_path)
		cache_data = json_decode(cache_text)
	catch(var/exception/e)
		return set_persistent_cache_failure("cache metadata could not be decoded: [e]")
	if(!islist(cache_data))
		return set_persistent_cache_failure("cache metadata was not a JSON object")
	if(cache_data["cache_revision"] != CUSTOM_MARKING_ATLAS_PERSISTENT_CACHE_REVISION)
		return set_persistent_cache_failure("cache schema revision changed")
	if(cache_data["manifest_revision"] != CUSTOM_MARKING_ATLAS_MANIFEST_REVISION)
		return set_persistent_cache_failure("client manifest revision changed")
	var/cache_atlas_name = cache_data["atlas_name"]
	if(cache_atlas_name != name)
		return set_persistent_cache_failure("cache belongs to atlas '[cache_atlas_name]' instead of '[name]'")
	var/cache_byond_version = cache_data["byond_version"]
	var/cache_byond_build = cache_data["byond_build"]
	if(cache_byond_version != world.byond_version || cache_byond_build != world.byond_build)
		return set_persistent_cache_failure("BYOND changed from [cache_byond_version].[cache_byond_build] to [world.byond_version].[world.byond_build]")
	var/cache_frame_count = cache_data["frame_count"]
	var/cache_sheet_count = cache_data["sheet_count"]
	var/list/cache_asset_names = cache_data["asset_names"]
	var/list/cache_file_records = cache_data["files"]
	var/list/cache_manifest = cache_data["manifest"]
	var/cache_manifest_asset_name = cache_data["manifest_asset_name"]
	var/list/cache_canonical_asset_ids = cache_data["canonical_asset_ids"]
	var/list/cache_manifest_assets = cache_manifest?["assets"]
	if(!isnum(cache_frame_count) || cache_frame_count <= 0 || !isnum(cache_sheet_count) || cache_sheet_count <= 0)
		return set_persistent_cache_failure("cache recorded invalid frame or sheet counts")
	if(!islist(cache_asset_names) || cache_asset_names.len != cache_sheet_count + 2)
		return set_persistent_cache_failure("cache asset-name count did not match its sheet count")
	if(!islist(cache_file_records) || cache_file_records.len != cache_asset_names.len)
		return set_persistent_cache_failure("cache file records were incomplete")
	if(!islist(cache_manifest) || cache_manifest["revision"] != CUSTOM_MARKING_ATLAS_MANIFEST_REVISION || !islist(cache_manifest_assets) || !islist(cache_manifest["prosthetics"]))
		return set_persistent_cache_failure("cache client manifest was invalid")
	if(!istext(cache_manifest_asset_name) || !(cache_manifest_asset_name in cache_asset_names))
		return set_persistent_cache_failure("cache manifest resource was absent from the asset list")
	if(!islist(cache_canonical_asset_ids) || cache_canonical_asset_ids.len != cache_frame_count || cache_manifest_assets.len != cache_frame_count)
		return set_persistent_cache_failure("cache canonical registry did not match its frame count")
	for(var/asset_name in cache_asset_names)
		var/list/file_record = cache_file_records[asset_name]
		var/cache_path = file_record?["path"]
		var/cache_md5 = file_record?["md5"]
		if(!istext(cache_path) || !length(cache_path) || !istext(cache_md5) || length(cache_md5) != 32)
			return set_persistent_cache_failure("cache file record for '[asset_name]' was invalid")
		if(!fexists(cache_path))
			return set_persistent_cache_failure("cache resource '[asset_name]' was missing")
		var/current_md5 = rustg_hash_file(RUSTG_HASH_MD5, cache_path)
		if(lowertext(current_md5) != lowertext(cache_md5))
			return set_persistent_cache_failure("cache resource '[asset_name]' failed its checksum")
	var/list/cache_payloads_by_key = list()
	for(var/canonical_key in cache_canonical_asset_ids)
		var/asset_id = cache_canonical_asset_ids[canonical_key]
		var/list/payload = cache_manifest_assets[asset_id]
		if(!istext(asset_id) || !length(asset_id) || !islist(payload) || payload["token"] != asset_id)
			return set_persistent_cache_failure("cache canonical registry contained a missing asset")
		var/atlas_asset_name = payload["atlas"]
		if(!istext(atlas_asset_name) || !(atlas_asset_name in cache_asset_names))
			return set_persistent_cache_failure("cache canonical asset '[asset_id]' referenced a missing sheet")
		cache_payloads_by_key[canonical_key] = payload
	accepting_assets = FALSE
	finalized = TRUE
	assets_registered = FALSE
	construction_state_released = TRUE
	finalized_frame_count = cache_frame_count
	finalized_sheet_count = cache_sheet_count
	finalized_asset_names = cache_asset_names
	finalized_sheet_diagnostics = cache_data["sheet_diagnostics"]
	finalized_manifest = cache_manifest
	finalized_manifest_asset_name = cache_manifest_asset_name
	requested_frame_count = cache_data["requested_frame_count"] || cache_frame_count
	reused_frame_count = cache_data["reused_frame_count"] || 0
	payloads_by_canonical_key = cache_payloads_by_key
	payloads_by_sprite = null
	payloads_by_asset_id = null
	canonical_keys_by_asset_id = null
	var/list/cache_families = cache_manifest["families"]
	family_statistics = islist(cache_families) ? cache_families : list()
	family_by_size_id = null
	shard_index_by_bucket = null
	sprites = null
	sizes = null
	persistent_cache_file_records = cache_file_records
	persistent_cache_used_keys = list()
	persistent_cache_validation_pending = TRUE
	return TRUE

/datum/asset/spritesheet/custom_marking_designer/proc/complete_persistent_cache_validation()
	if(!persistent_cache_validation_pending)
		return FALSE
	if(!custom_marking_static_source_digest_complete)
		return set_persistent_cache_failure("one or more static source resources could not be hashed", TRUE)
	if(persistent_cache_validation_failed)
		return FALSE
	if(!islist(persistent_cache_used_keys) || !islist(payloads_by_canonical_key) || persistent_cache_used_keys.len != payloads_by_canonical_key.len)
		return set_persistent_cache_failure("the live canonical key set changed", TRUE)
	for(var/canonical_key in payloads_by_canonical_key)
		if(!persistent_cache_used_keys[canonical_key])
			return set_persistent_cache_failure("the live catalog no longer requested cached asset [md5(canonical_key)]", TRUE)
	if(!SSassets || !islist(SSassets.cache) || !islist(persistent_cache_file_records))
		return set_persistent_cache_failure("the asset subsystem was unavailable", TRUE)
	for(var/asset_name in finalized_asset_names)
		var/list/file_record = persistent_cache_file_records[asset_name]
		var/cache_path = file_record?["path"]
		var/cache_md5 = file_record?["md5"]
		var/datum/asset_cache_item/existing_asset = SSassets.cache[asset_name]
		if(istype(existing_asset))
			if(lowertext(existing_asset.md5) != lowertext(cache_md5))
				return set_persistent_cache_failure("asset cache already contained different bytes for '[asset_name]'", TRUE)
			continue
		var/cache_resource = file(cache_path)
		var/datum/asset_cache_item/registered_asset = register_asset(asset_name, cache_resource)
		if(!istype(registered_asset) || !registered_asset.resource || lowertext(registered_asset.md5) != lowertext(cache_md5))
			return set_persistent_cache_failure("cache resource '[asset_name]' could not be registered", TRUE)
	assets_registered = TRUE
	persistent_cache_validation_pending = FALSE
	persistent_cache_loaded = registered_assets_available()
	if(!persistent_cache_loaded || !is_ready())
		return set_persistent_cache_failure("registered cache did not become client-ready", TRUE)
	persistent_cache_used_keys = null
	return TRUE

/datum/asset/spritesheet/custom_marking_designer/proc/reset_after_persistent_cache_miss()
	accepting_assets = TRUE
	finalized = FALSE
	assets_registered = FALSE
	construction_state_released = FALSE
	finalized_frame_count = 0
	finalized_sheet_count = 0
	finalized_asset_names = null
	finalized_sheet_diagnostics = null
	finalized_manifest = null
	finalized_manifest_asset_name = null
	next_sprite_id = 0
	requested_frame_count = 0
	reused_frame_count = 0
	payloads_by_sprite = list()
	payloads_by_canonical_key = list()
	payloads_by_asset_id = list()
	canonical_keys_by_asset_id = list()
	family_statistics = list()
	family_by_size_id = list()
	shard_index_by_bucket = list()
	prosthetic_catalog = list()
	sprites = list()
	sizes = list()
	persistent_cache_validation_pending = FALSE
	persistent_cache_validation_failed = FALSE
	persistent_cache_loaded = FALSE
	persistent_cache_write_succeeded = FALSE
	persistent_cache_file_records = null
	persistent_cache_used_keys = null
	return TRUE

/datum/asset/spritesheet/custom_marking_designer/proc/persist_finalized_cache()
	persistent_cache_write_succeeded = FALSE
	if(!persistent_cache_enabled || persistent_cache_loaded)
		return FALSE
	if(!is_ready() || !registered_assets_available())
		return set_persistent_cache_failure("only a client-ready atlas can be persisted")
	if(!custom_marking_static_source_digest_complete)
		return set_persistent_cache_failure("static source hashing was incomplete")
	var/list/canonical_asset_ids = list()
	for(var/canonical_key in payloads_by_canonical_key)
		var/list/payload = payloads_by_canonical_key[canonical_key]
		var/asset_id = payload?["token"]
		if(!istext(asset_id) || !length(asset_id))
			return set_persistent_cache_failure("canonical asset [md5(canonical_key)] had no stable id")
		canonical_asset_ids[canonical_key] = asset_id
	if(canonical_asset_ids.len != finalized_frame_count)
		return set_persistent_cache_failure("canonical registry did not match the finalized frame count")
	var/list/file_records = list()
	for(var/asset_name in finalized_asset_names)
		var/datum/asset_cache_item/cached_asset = SSassets.cache[asset_name]
		if(!istype(cached_asset) || !cached_asset.resource || !istext(cached_asset.md5) || length(cached_asset.md5) != 32)
			return set_persistent_cache_failure("registered resource '[asset_name]' was unavailable for persistence")
		var/cache_path = "data/spritesheets/[name]_persistent_v[CUSTOM_MARKING_ATLAS_PERSISTENT_CACHE_REVISION]_[cached_asset.md5].cache"
		var/cache_is_current = fexists(cache_path) && lowertext(rustg_hash_file(RUSTG_HASH_MD5, cache_path)) == lowertext(cached_asset.md5)
		if(!cache_is_current)
			if(fexists(cache_path))
				fdel(cache_path)
			if(!fcopy(cached_asset.resource, cache_path))
				return set_persistent_cache_failure("registered resource '[asset_name]' could not be copied to disk")
			if(lowertext(rustg_hash_file(RUSTG_HASH_MD5, cache_path)) != lowertext(cached_asset.md5))
				return set_persistent_cache_failure("persisted resource '[asset_name]' failed its checksum")
		file_records[asset_name] = list(
			"path" = cache_path,
			"md5" = cached_asset.md5
		)
	var/list/cache_data = list(
		"cache_revision" = CUSTOM_MARKING_ATLAS_PERSISTENT_CACHE_REVISION,
		"manifest_revision" = CUSTOM_MARKING_ATLAS_MANIFEST_REVISION,
		"atlas_name" = name,
		"byond_version" = world.byond_version,
		"byond_build" = world.byond_build,
		"frame_count" = finalized_frame_count,
		"sheet_count" = finalized_sheet_count,
		"requested_frame_count" = requested_frame_count,
		"reused_frame_count" = reused_frame_count,
		"asset_names" = finalized_asset_names,
		"sheet_diagnostics" = finalized_sheet_diagnostics,
		"manifest" = finalized_manifest,
		"manifest_asset_name" = finalized_manifest_asset_name,
		"canonical_asset_ids" = canonical_asset_ids,
		"files" = file_records
	)
	var/cache_json
	try
		cache_json = json_encode(cache_data)
	catch(var/exception/e)
		return set_persistent_cache_failure("cache metadata could not be encoded: [e]")
	if(!istext(cache_json) || !length(cache_json))
		return set_persistent_cache_failure("cache metadata encoded to an empty value")
	var/cache_metadata_path = get_persistent_cache_path()
	var/cache_metadata_temp_path = "[cache_metadata_path].[world.realtime].[rand(1000, 9999)].tmp"
	if(fexists(cache_metadata_temp_path))
		fdel(cache_metadata_temp_path)
	rustg_file_write(cache_json, cache_metadata_temp_path)
	if(!fexists(cache_metadata_temp_path))
		return set_persistent_cache_failure("temporary cache metadata could not be written")
	if(fexists(cache_metadata_path))
		fdel(cache_metadata_path)
	if(!fcopy(cache_metadata_temp_path, cache_metadata_path))
		fdel(cache_metadata_temp_path)
		return set_persistent_cache_failure("cache metadata could not be committed")
	fdel(cache_metadata_temp_path)
	if(!fexists(cache_metadata_path))
		return set_persistent_cache_failure("committed cache metadata was missing")
	persistent_cache_file_records = file_records
	persistent_cache_failure_reason = null
	persistent_cache_write_succeeded = TRUE
	return TRUE

/datum/asset/spritesheet/custom_marking_designer/proc/add_icon_asset(icon/source, token, shift_x = 0, shift_y = 0, canonical_key = null, family = null)
	if(!isicon(source))
		return null
	if(!is_valid_family(family))
		stack_trace("Custom Marking Designer canonical asset insertion rejected invalid family '[family]'.")
		return null
	if(persistent_cache_validation_pending)
		var/list/cached_payload = note_icon_asset_request(canonical_key, family)
		if(islist(cached_payload))
			if(cached_payload["width"] != source.Width() || cached_payload["height"] != source.Height() || cached_payload["shift_x"] != shift_x || cached_payload["shift_y"] != shift_y)
				set_persistent_cache_failure("canonical asset [md5(canonical_key)] changed dimensions or shifts", TRUE)
				return null
			return cached_payload
		set_persistent_cache_failure("the live catalog requested uncached asset [md5(canonical_key)]", TRUE)
		return null
	if(!can_accept_assets())
		return null
	if(!istext(canonical_key) || !length(canonical_key))
		canonical_key = "occurrence-v1|[name]|[next_sprite_id + 1]|[token]"
	var/list/existing_payload = get_icon_asset(canonical_key)
	if(islist(existing_payload))
		if(existing_payload["width"] != source.Width() || existing_payload["height"] != source.Height() || existing_payload["shift_x"] != shift_x || existing_payload["shift_y"] != shift_y)
			stack_trace("Custom Marking Designer canonical key [canonical_key] was reused with incompatible dimensions or shifts.")
			return null
		return note_icon_asset_request(canonical_key, family)
	var/canonical_digest = md5(canonical_key)
	var/asset_id = "cmd-v[CUSTOM_MARKING_ATLAS_MANIFEST_REVISION]-[canonical_digest]"
	var/existing_key = canonical_keys_by_asset_id[asset_id]
	if(istext(existing_key) && existing_key != canonical_key)
		stack_trace("Custom Marking Designer canonical asset id collision between [existing_key] and [canonical_key].")
		return null
	next_sprite_id++
	requested_frame_count++
	var/list/request_statistics = get_or_create_family_statistics(family)
	if(!islist(request_statistics))
		return null
	request_statistics["requested"] = (request_statistics["requested"] || 0) + 1
	var/sprite_name = canonical_digest
	if(!insert_family_frame(sprite_name, source, family))
		return null
	var/list/payload = list(
		"token" = asset_id,
		"width" = source.Width(),
		"height" = source.Height(),
		"shift_x" = shift_x,
		"shift_y" = shift_y,
		"canonical" = TRUE,
		"family" = family
	)
	payloads_by_sprite[sprite_name] = payload
	payloads_by_canonical_key[canonical_key] = payload
	payloads_by_asset_id[asset_id] = payload
	canonical_keys_by_asset_id[asset_id] = canonical_key
	request_statistics["frames"] = (request_statistics["frames"] || 0) + 1
	return payload

/datum/asset/spritesheet/custom_marking_designer/proc/build_finalized_manifest()
	var/list/assets = list()
	for(var/asset_id in payloads_by_asset_id)
		var/list/payload = payloads_by_asset_id[asset_id]
		if(islist(payload))
			assets[asset_id] = payload
	var/list/families = list()
	for(var/family in family_statistics)
		if(!is_valid_family(family))
			stack_trace("Custom Marking Designer canonical manifest rejected invalid family '[family]'.")
			return null
		var/list/statistics = family_statistics[family]
		if(islist(statistics))
			families[family] = statistics.Copy()
	return list(
		"revision" = CUSTOM_MARKING_ATLAS_MANIFEST_REVISION,
		"assets" = assets,
		"families" = families,
		"prosthetics" = islist(prosthetic_catalog) ? prosthetic_catalog : list()
	)

/datum/asset/spritesheet/custom_marking_designer/proc/register_finalized_manifest_asset()
	if(!islist(finalized_manifest))
		return null
	var/manifest_json = json_encode(finalized_manifest)
	if(!istext(manifest_json) || !length(manifest_json))
		return null
	var/manifest_digest = md5(manifest_json)
	if(!istext(manifest_digest) || !length(manifest_digest))
		return null
	var/asset_name = "[name]_manifest_v[CUSTOM_MARKING_ATLAS_MANIFEST_REVISION]_[manifest_digest].json"
	var/manifest_path = "data/spritesheets/[asset_name]"
	fdel(manifest_path)
	if(!text2file(manifest_json, manifest_path))
		return null
	var/manifest_resource = fcopy_rsc(manifest_path)
	fdel(manifest_path)
	if(!isfile(manifest_resource))
		return null
	var/datum/asset_cache_item/cached_manifest = register_asset(asset_name, manifest_resource)
	if(!istype(cached_manifest) || !cached_manifest.resource)
		return null
	finalized_manifest_asset_name = asset_name
	return asset_name

/datum/asset/spritesheet/custom_marking_designer/proc/finalize()
	if(finalized)
		return is_ready()
	if(!accepting_assets)
		return FALSE
	accepting_assets = FALSE
	if(!has_assets())
		return FALSE
	finalized_frame_count = sprites.len
	finalized_sheet_count = sizes.len
	finalized = TRUE
	register()
	if(!assets_registered)
		return FALSE
	var/list/pending_asset_names = list("spritesheet_[name].css")
	var/list/pending_sheet_diagnostics = list()
	var/diagnostic_frame_total = 0
	for(var/size_id in sizes)
		var/list/size = sizes[size_id]
		var/icon/atlas_icon = size?[CUSTOM_MARKING_ATLAS_SIZE_STRIPPED]
		if(!islist(size) || !isicon(atlas_icon))
			stack_trace("Custom Marking Designer atlas could not retain diagnostics for sheet [size_id].")
			return FALSE
		var/asset_name = "[name]_[size_id].png"
		var/sheet_frames = size[CUSTOM_MARKING_ATLAS_SIZE_COUNT] || 0
		var/family = family_by_size_id[size_id]
		if(!is_valid_family(family))
			stack_trace("Custom Marking Designer atlas sheet [size_id] has invalid family '[family]'.")
			return FALSE
		diagnostic_frame_total += sheet_frames
		pending_asset_names += asset_name
		pending_sheet_diagnostics[asset_name] = list(
			"frames" = sheet_frames,
			"width" = atlas_icon.Width(),
			"height" = atlas_icon.Height(),
			"family" = family
		)
		var/list/statistics = get_or_create_family_statistics(family)
		if(!islist(statistics))
			return FALSE
		var/list/family_sheets = statistics["sheets"]
		if(!islist(family_sheets))
			family_sheets = list()
			statistics["sheets"] = family_sheets
		family_sheets += asset_name
	if(pending_sheet_diagnostics.len != finalized_sheet_count || diagnostic_frame_total != finalized_frame_count)
		stack_trace("Custom Marking Designer atlas diagnostics do not match finalized construction state ([diagnostic_frame_total]/[finalized_frame_count] frames, [pending_sheet_diagnostics.len]/[finalized_sheet_count] sheets).")
		return FALSE
	var/coordinates_assigned = 0
	for(var/sprite_name in payloads_by_sprite)
		var/list/payload = payloads_by_sprite[sprite_name]
		var/list/sprite = sprites?[sprite_name]
		if(!islist(payload) || !islist(sprite))
			stack_trace("Custom Marking Designer atlas could not assign coordinates for [sprite_name].")
			return FALSE
		var/size_id = sprite[CUSTOM_MARKING_ATLAS_SPRITE_SIZE]
		var/index = sprite[CUSTOM_MARKING_ATLAS_SPRITE_INDEX]
		var/list/size = sizes?[size_id]
		var/icon/cell_icon = size?[CUSTOM_MARKING_ATLAS_SIZE_ICON]
		var/icon/atlas_icon = size?[CUSTOM_MARKING_ATLAS_SIZE_STRIPPED]
		if(!isicon(cell_icon) || !isicon(atlas_icon))
			stack_trace("Custom Marking Designer atlas could not resolve sheet [size_id] for [sprite_name].")
			return FALSE
		var/per_line = max(1, round(atlas_icon.Width() / cell_icon.Width()))
		payload["atlas"] = "[name]_[size_id].png"
		payload["atlas_x"] = (index % per_line) * cell_icon.Width()
		payload["atlas_y"] = round(index / per_line) * cell_icon.Height()
		coordinates_assigned++
	if(coordinates_assigned != finalized_frame_count)
		stack_trace("Custom Marking Designer atlas assigned [coordinates_assigned] coordinates for [finalized_frame_count] frames.")
		return FALSE
	finalized_sheet_diagnostics = pending_sheet_diagnostics
	finalized_manifest = build_finalized_manifest()
	var/manifest_asset_name = register_finalized_manifest_asset()
	if(!istext(manifest_asset_name) || !length(manifest_asset_name))
		stack_trace("Custom Marking Designer atlas could not register its finalized manifest asset.")
		return FALSE
	finalized_asset_names = list(manifest_asset_name)
	finalized_asset_names += pending_asset_names
	if(!registered_assets_available())
		stack_trace("Custom Marking Designer atlas cannot release construction state because one or more registered resources are unavailable.")
		return FALSE
	payloads_by_sprite = null
	sprites = null
	sizes = null
	payloads_by_asset_id = null
	canonical_keys_by_asset_id = null
	family_by_size_id = null
	shard_index_by_bucket = null
	prosthetic_catalog = null
	next_sprite_id = 0
	construction_state_released = TRUE
	return TRUE

#undef CUSTOM_MARKING_ATLAS_SPRITE_SIZE
#undef CUSTOM_MARKING_ATLAS_SPRITE_INDEX
#undef CUSTOM_MARKING_ATLAS_SIZE_COUNT
