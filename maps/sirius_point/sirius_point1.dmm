"sGe" = (
/obj/structure/table/woodentable,
/obj/item/weapon/paper{
	info = "For many years, Nanotrasen's whaling division has maintained a proud culture of honest, hardworking whalers dedicated to honing their craft. It is with great regret that, following a series of hard decisions about the allocation of budget cuts, we have decided to close the whaling department down permanently. In spite of many brave and dangerous expeditions, the latest audit has revealed that, in its 150-year history, the whaling department has consistently failed to meet their quota of a single whale every financial year, and the board of directors has decided to allocate the budget elsewhere. All workers will be provided with one month's severance, and priority placement in the newly founded gambling and tackle department.";
	name = "Closure Announcement"
	},
/turf/simulated/floor/carpet,
/area/maintenance/moonbase/basement/whalers)
